rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedSchoolGoogleUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^[^@]+@ryugasaki1-h[.]ibk[.]ed[.]jp$')
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isConfiguredAdminEmail(email) {
      return email in [
        'saito.nozomu@ryugasaki1-h.ibk.ed.jp',
        'kobayashi.takuto@ryugasaki1-h.ibk.ed.jp'
      ];
    }

    function isAdmin() {
      return isAllowedSchoolGoogleUser()
        && isConfiguredAdminEmail(request.auth.token.email);
    }

    function isValidProfile(userId) {
      return request.resource.data.keys().hasAll(['id', 'email', 'name', 'role', 'className', 'avatarColor', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['id', 'email', 'name', 'role', 'className', 'avatarColor', 'childName', 'photoUrl', 'createdAt', 'updatedAt'])
        && request.resource.data.id == userId
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.className is string
        && ((isConfiguredAdminEmail(request.resource.data.email)
            && request.resource.data.role == 'admin'
            && request.resource.data.className == '管理者')
          || (!isConfiguredAdminEmail(request.resource.data.email)
            && request.resource.data.role in ['student', 'parent']
            && request.resource.data.className.matches('^[1-3]年([1-9]|10)組$')));
    }

    function preservesProfileIdentity() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function hasValidModerationSubmission(reviewId) {
      return request.resource.data.keys().hasAll([
          'id', 'className', 'category', 'title', 'content', 'targetDate', 'memo',
          'submittedAt', 'authorId', 'authorName', 'authorEmail', 'aiCategory',
          'aiReason', 'status'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'className', 'category', 'title', 'content', 'targetDate', 'memo',
          'submittedAt', 'authorId', 'authorName', 'authorEmail', 'aiCategory',
          'aiReason', 'status'
        ])
        && request.resource.data.id == reviewId
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorEmail == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.className is string
        && request.resource.data.category in ['持ち物', '宿題', '提出物', '時間割変更', '行事', '部活動', 'その他']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 500
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 200
        && request.resource.data.targetDate is string
        && request.resource.data.targetDate.size() <= 10
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 40
        && request.resource.data.aiCategory is string
        && request.resource.data.aiCategory.size() <= 40
        && request.resource.data.aiReason is string
        && request.resource.data.aiReason.size() > 0
        && request.resource.data.aiReason.size() <= 1000;
    }

    function isValidModerationDecision() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedAt', 'reviewedBy', 'reviewedByName', 'decisionReason', 'contactId'
        ])
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedAt is string
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedByName is string
        && request.resource.data.reviewedByName.size() > 0
        && request.resource.data.reviewedByName.size() <= 40
        && request.resource.data.decisionReason is string
        && request.resource.data.decisionReason.size() > 0
        && request.resource.data.decisionReason.size() <= 300
        && (request.resource.data.status == 'rejected'
          || (request.resource.data.contactId is string && request.resource.data.contactId.size() > 0));
    }

    function isValidCorrectableContact(value) {
      return value is map
        && value.keys().hasAll(['title', 'content', 'targetDate', 'memo'])
        && value.keys().hasOnly(['title', 'content', 'targetDate', 'memo'])
        && value.title is string && value.title.size() > 0 && value.title.size() <= 60
        && value.content is string && value.content.size() > 0 && value.content.size() <= 500
        && value.targetDate is string && value.targetDate.size() <= 10
        && value.memo is string && value.memo.size() <= 200;
    }

    function hasValidCorrectionReport(reportId) {
      return request.resource.data.keys().hasAll([
          'id', 'className', 'contactId', 'contactTitle', 'contactRevision',
          'reportedContact', 'reporterId', 'reporterName', 'reporterEmail',
          'reporterRole', 'reason', 'details', 'submittedAt', 'status'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'className', 'contactId', 'contactTitle', 'contactRevision',
          'reportedContact', 'reporterId', 'reporterName', 'reporterEmail',
          'reporterRole', 'reason', 'details', 'submittedAt', 'status'
        ])
        && request.resource.data.id == reportId
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reporterEmail == request.auth.token.email
        && request.resource.data.reporterRole in ['student', 'parent']
        && request.resource.data.status == 'pending'
        && request.resource.data.className is string
        && request.resource.data.contactId is string
        && request.resource.data.contactId.size() > 0
        && request.resource.data.contactTitle is string
        && request.resource.data.contactTitle.size() > 0
        && request.resource.data.contactTitle.size() <= 60
        && request.resource.data.contactRevision is int
        && request.resource.data.contactRevision > 0
        && isValidCorrectableContact(request.resource.data.reportedContact)
        && request.resource.data.reporterName is string
        && request.resource.data.reporterName.size() > 0
        && request.resource.data.reporterName.size() <= 40
        && request.resource.data.reason in ['聞いた内容と違う', '日時・期限が違う', '持ち物・場所が違う', '内容が古くなった', 'その他']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 300
        && request.resource.data.submittedAt is string;
    }

    function isValidCorrectionDecision() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'resolvedAt', 'resolvedBy', 'resolvedByName', 'decisionNote',
          'previousContact', 'correctedContact'
        ])
        && resource.data.status == 'pending'
        && request.resource.data.status in ['corrected', 'dismissed']
        && request.resource.data.resolvedAt is string
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolvedByName is string
        && request.resource.data.resolvedByName.size() > 0
        && request.resource.data.resolvedByName.size() <= 40
        && request.resource.data.decisionNote is string
        && request.resource.data.decisionNote.size() > 0
        && request.resource.data.decisionNote.size() <= 300
        && (request.resource.data.status == 'dismissed'
          || (isValidCorrectableContact(request.resource.data.previousContact)
            && isValidCorrectableContact(request.resource.data.correctedContact)));
    }

    match /teacherslogProfiles/{userId} {
      allow get: if isAdmin()
        || (isAllowedSchoolGoogleUser()
          && (request.auth.uid == userId
            || (exists(/databases/$(database)/documents/teacherslogProfiles/$(request.auth.uid))
              && resource.data.className == get(/databases/$(database)/documents/teacherslogProfiles/$(request.auth.uid)).data.className)));
      allow list: if isAdmin()
        || (isAllowedSchoolGoogleUser()
          && exists(/databases/$(database)/documents/teacherslogProfiles/$(request.auth.uid))
          && resource.data.className == get(/databases/$(database)/documents/teacherslogProfiles/$(request.auth.uid)).data.className);
      allow create: if isAllowedSchoolGoogleUser()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && isValidProfile(userId);
      allow update: if isAllowedSchoolGoogleUser()
        && isValidProfile(userId)
        && preservesProfileIdentity()
        && (
          (isAdmin() && !isConfiguredAdminEmail(resource.data.email))
          || (
            request.auth.uid == userId
            && request.resource.data.email == request.auth.token.email
            && (
              (isConfiguredAdminEmail(request.auth.token.email)
                && request.resource.data.role == 'admin')
              || (
                !isConfiguredAdminEmail(request.auth.token.email)
                && (
                  (request.resource.data.role == resource.data.role
                    && request.resource.data.className == resource.data.className)
                  || (resource.data.role == 'admin'
                    && request.resource.data.role in ['student', 'parent'])
                )
              )
            )
          )
        );
      allow delete: if false;
    }

    match /teacherslogClasses/{className} {
      allow read, write: if isAdmin()
        || (isAllowedSchoolGoogleUser()
          && exists(/databases/$(database)/documents/teacherslogProfiles/$(request.auth.uid))
          && get(/databases/$(database)/documents/teacherslogProfiles/$(request.auth.uid)).data.className == className);
    }

    match /teacherslogModerationQueue/{reviewId} {
      allow read: if isAdmin()
        || (isAllowedSchoolGoogleUser() && resource.data.authorId == request.auth.uid);
      allow create: if isAllowedSchoolGoogleUser()
        && exists(/databases/$(database)/documents/teacherslogProfiles/$(request.auth.uid))
        && (isAdmin()
          || get(/databases/$(database)/documents/teacherslogProfiles/$(request.auth.uid)).data.className == request.resource.data.className)
        && hasValidModerationSubmission(reviewId);
      allow update: if isAdmin() && isValidModerationDecision();
      allow delete: if false;
    }

    match /teacherslogCorrectionReports/{reportId} {
      allow read: if isAdmin()
        || (isAllowedSchoolGoogleUser() && resource.data.reporterId == request.auth.uid);
      allow create: if isAllowedSchoolGoogleUser()
        && exists(/databases/$(database)/documents/teacherslogProfiles/$(request.auth.uid))
        && (isAdmin()
          || (get(/databases/$(database)/documents/teacherslogProfiles/$(request.auth.uid)).data.className == request.resource.data.className
            && get(/databases/$(database)/documents/teacherslogProfiles/$(request.auth.uid)).data.role == request.resource.data.reporterRole))
        && hasValidCorrectionReport(reportId);
      allow update: if isAdmin() && isValidCorrectionDecision();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
